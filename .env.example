# Taskman Environment Configuration Template
# Copy this file to .env and fill in your values.
# DO NOT commit .env with sensitive values to version control.

# ============================================================================
# Shared — every component needs this one
# ============================================================================
# Neon / Supabase / Render Postgres / local. Crons, API and migrations all use it.
DATABASE_URL=postgresql://localhost:5432/taskman
PGSSL=prefer
PGPOOL_MAX=5

# ============================================================================
# Legacy engine (src/server.js)
# ============================================================================
PORT=3000
NODE_ENV=development
TASKMAN_BASE_URL=http://localhost:3000
TASKMAN_ROLE=web
TASKMAN_AUTH_MODE=disabled
TASKMAN_TENANT_MODE=single-tenant

# Set to 'true' to enable the internal cron/durable scheduler loop.
# Leave false when the crons in .github/workflows are running: both write the
# same slot keys, so this is safe either way, but running one is enough.
TASKMAN_INTERNAL_SCHEDULER_ENABLED=false
TASKMAN_BRAIN_INTERVAL_MINUTES=0
TASKMAN_REASONING_ENABLED=true

# Write-capable rails are denied by default. Production requires an explicit list.
# Composes with the settlement-ledger gate in src/rails/dead-rails.js: a rail
# needs BOTH this allowlist entry AND a non-DISABLED ledger state to execute.
TASKMAN_ALLOW_WRITE_RAILS=false
# TASKMAN_WRITE_RAILS=taskforce
# Optional generic brain cadence: a whole number from 1 to 44640 minutes.
# Blank/unset disables the brain timer; invalid values fail closed.
# TASKMAN_BRAIN_INTERVAL_MINUTES=60

# Resource and deadline limits (bounded defaults shown)
TASKMAN_MAX_JSON_BODY_BYTES=1048576
TASKMAN_PROVIDER_TIMEOUT_MS=45000
TASKMAN_RUN_TIMEOUT_MS=300000
TASKMAN_HTTP_REQUEST_TIMEOUT_MS=120000
TASKMAN_HTTP_HEADERS_TIMEOUT_MS=15000
TASKMAN_HTTP_KEEP_ALIVE_TIMEOUT_MS=5000

# Service-to-service authentication (Issue #13)
# TASKMAN_API_KEY=your-secure-taskman-api-key
# TASKMAN_KNOWLEDGE_PATH=             # override the knowledge seed location

# ============================================================================
# API component (packages/api)
# ============================================================================
API_PORT=3100
CORS_ORIGIN=*                        # set to the deployed UI origin in production
TASKMAN_API_TOKEN=                   # set it and mutating routes require Bearer auth

# ============================================================================
# UI component (packages/web)
# ============================================================================
WEB_PORT=3200

# ============================================================================
# Crons (packages/crons)
# ============================================================================
# health-check verifies the other components are actually reachable.
API_HEALTH_URL=http://localhost:3100/api/health
WEB_HEALTH_URL=http://localhost:3200

# ============================================================================
# Money — settlement verification is read-only and never moves funds
# ============================================================================
STRIPE_API_KEY=

# ============================================================================
# External AI providers (at least one recommended for AI-assisted runs)
# ============================================================================
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# ============================================================================
# Income rails (optional) — see docs/TARGET_DESIGN.md §2 before enabling these
# ============================================================================
# Public read-only DeskCrew / Taskmarket discovery. Write/payment capabilities
# remain unavailable regardless of these flags.
DESKCREW_ENABLED=false
TASKMARKET_ENABLED=false
# MOLTJOBS_API_KEY=
# MOLTJOBS_BASE_URL=https://api.moltjobs.io/v1
# TASKFORCE_API_KEY=
# TASKFORCE_BASE_URL=https://www.task-force.app
