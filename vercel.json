{
  "version": 2,
  "public": true,
  "builds": [
    {
      "src": "packages/web/public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/packages/web/public/assets/$1"
    },
    {
      "src": "/grok-gate/(.*)",
      "dest": "/packages/web/public/grok-gate/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/packages/web/public/$1"
    }
  ]
}
