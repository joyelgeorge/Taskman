{
  "name": "taskman",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "migrate:all": "node packages/db/migrate.js",
    "preflight": "node scripts/preflight.js",
    "import:history": "node scripts/import-opportunity-history.js",
    "import:money-flow-history": "node scripts/import-money-flow-search-history.js",
    "test": "node --test",
    "api": "node packages/api/server.js",
    "web": "node packages/web/server.js",
    "cron": "node --env-file-if-exists=.env packages/crons/cli.js",
    "scheduler": "node --env-file-if-exists=.env packages/crons/scheduler.js",
    "smoke": "node packages/crons/smoke.js",
    "sync:audit": "node scripts/sync-audit-assets.js",
    "build:audit-site": "node scripts/build-audit-site.js",
    "fulfil": "node scripts/fulfil-audit.js",
    "outreach": "node --env-file-if-exists=.env scripts/outreach.mjs",
    "brief": "node --env-file-if-exists=.env scripts/brief.mjs",
    "research": "node --env-file-if-exists=.env scripts/research.mjs",
    "tasks": "node scripts/tasks.mjs",
    "job": "node --env-file-if-exists=.env scripts/job.mjs",
    "next": "node --env-file-if-exists=.env scripts/next.mjs",
    "scan-bundles": "node --env-file-if-exists=.env scripts/scan-bundles.mjs",
    "warm-scout": "node --env-file-if-exists=.env scripts/warm-lead-scout.mjs",
    "self-serve": "node --env-file-if-exists=.env scripts/self-serve-scan.mjs",
    "scan-server": "node --env-file-if-exists=.env packages/web/scan-server/server.js",
    "tally": "node --env-file-if-exists=.env scripts/tally-audit.mjs",
    "jez-research": "node --env-file-if-exists=.env scripts/jez-research.mjs"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "workspaces": [
    "packages/*"
  ]
}
