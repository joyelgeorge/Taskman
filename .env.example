# Taskman Environment Configuration Template
# Copy this file to .env and fill in your values
# DO NOT commit .env with sensitive values to version control

# Server Configuration
PORT=3000
NODE_ENV=development
TASKMAN_BASE_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
# Required for durable persistence, queue locks, and scheduler
DATABASE_URL=postgresql://localhost:5432/taskman
# Bounded PostgreSQL runtime policy (defaults shown)
PGPOOL_MAX=5
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
PG_POOL_MAX_LIFETIME_SECONDS=300
PG_STATEMENT_TIMEOUT_MS=30000
PG_QUERY_TIMEOUT_MS=35000
PG_LOCK_TIMEOUT_MS=5000
PG_IDLE_TRANSACTION_TIMEOUT_MS=30000
PG_MIGRATION_STATEMENT_TIMEOUT_MS=300000
PG_MIGRATION_LOCK_TIMEOUT_MS=30000

# Scheduler Configuration
# Set to 'true' to enable internal cron/durable scheduler loop
TASKMAN_INTERNAL_SCHEDULER_ENABLED=false

# Service-to-Service Authentication (Required after Issue #13)
# TASKMAN_API_KEY=your-secure-taskman-api-key

# External AI Providers (At least one recommended for AI-assisted runs)
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=

# Income Rails & Connectors (Optional)
# MOLTJOBS_API_KEY=
# Webhook ingress is disabled unless this separate high-entropy secret is set.
# Generate independently from API credentials; never reuse MOLTJOBS_API_KEY.
# MOLTJOBS_WEBHOOK_SECRET=
# MOLTJOBS_WEBHOOK_SECRET_PREVIOUS=
# MOLTJOBS_WEBHOOK_EVENTS=message.created
